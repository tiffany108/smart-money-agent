# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Despite the name, this holds a privileged key. Use the sb_secret_... value
# from Supabase → Settings → API Keys → "Publishable and secret API keys".
SUPABASE_ANON_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── News APIs ──────────────────────────────────────────────────────────────
NEWSAPI_KEY=your_key_here
GNEWS_KEY=your_key_here

# ── AI summariser ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Which platforms to generate drafts for. Each extra platform multiplies the
# Anthropic bill — only add one when you can actually publish to it.
#   facebook only          -> 20 API calls per run
#   all four platforms     -> 50 API calls per run
# Valid: instagram, linkedin, facebook, threads
SUMMARISE_PLATFORMS=facebook

# Articles processed per run. Higher = more spend per run.
SUMMARISE_BATCH_SIZE=5

# Sonnet 5 is $2/$10 per million tokens; Sonnet 4.6 is $3/$15.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Meta / Facebook ────────────────────────────────────────────────────────
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_PAGE_ACCESS_TOKEN=your_page_token
META_VERIFY_TOKEN=your_webhook_verify_token

# Numeric ID of the Page you publish to.
FB_PAGE_ID=your_page_id

# ── Publishing safety ──────────────────────────────────────────────────────
# Both of these must be set for anything to be posted publicly.
# Leave them as-is unless you are deliberately going live.
#
#   DRY_RUN=true          → log what would be posted, post nothing (DEFAULT)
#   DRY_RUN=false         → arm publishing
#   PUBLISH_ENABLED=true  → kill switch; must also be "true" to post
#
DRY_RUN=true
PUBLISH_ENABLED=false

# Caps the blast radius of any bug. Start small.
MAX_POSTS_PER_RUN=2
PUBLISH_DELAY_MS=5000

# ── Scheduler ──────────────────────────────────────────────────────────────
SCHEDULE_PLATFORMS=facebook
SCHEDULE_MAX_PER_RUN=20
